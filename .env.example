# Base de données Cloud Neon PostgreSQL (côté serveur uniquement — NE JAMAIS préfixer par VITE_)
DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@VOTRE_HOTE.neon.tech/VOTRE_BASE?sslmode=require"

# Clé secrète serveur de signature des jetons de session.
# OBLIGATOIRE en production (Vercel) : sans elle, chaque instance serverless
# signerait avec un secret différent et déconnecterait les utilisateurs.
# En local, un secret est généré et persisté dans .salon-auth-secret si vide.
# Génération : openssl rand -hex 32
SALON_AUTH_SECRET=""

# Code d'accès serveur historique (facultatif, déprécié) : uniquement pour une
# synchronisation machine sans session utilisateur. Ne remplace pas SALON_AUTH_SECRET.
SALON_SYNC_PIN=""
